# Copy this file to .env.local and fill in the values. .env.local is git-ignored; never commit real keys.

# Existing: AI ranking (optional; the app falls back to rule-based order without it)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Contact form -> Supabase (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Contact form -> emails through Gmail (see docs/CONTACT-FORM-SETUP.md)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Where the "new enquiry" email goes. Leave out to send it to GMAIL_USER.
OWNER_EMAIL=you@gmail.com
